# Local Node.js server configuration reference. Export these variables in the
# shell or configure them in the process manager; npm scripts do not load this
# file automatically. Every value here is optional and harmless. Never commit
# real secrets.

# HTTP port for the API server.
PORT=8787

# SQLite database location (parent directories are created).
ASCIIWEAVE_DB=data/asciiweave.db

# Build identity reported by /api/health.
GIT_COMMIT=dev
